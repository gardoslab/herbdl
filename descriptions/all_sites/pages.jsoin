                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.7",
                        "name": "What Are The Different Petunia Flowers - Gardening Know How",
                        "url": "https://www.gardeningknowhow.com/ornamental/flowers/petunia/different-petunia-flowers.htm",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.Ow7mJYyZl-LGjI0HTEqRZgHaJs&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2021-05-15T00:00:00.0000000",
                        "datePublishedDisplayText": "May 15, 2021",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.gardeningknowhow.com/ornamental/flowers/petunia/different-petunia-flowers.htm",
                        "snippet": "Milliflora petunia varieties produce masses of 1- to 1 \u00bd-inch (2.5-4 cm.) blooms on miniature plants. The mature size of the plants is generally about 8 inches (20.5 cm.) tall and wide. Milliflora petunias bloom early and are often grown in containers or hanging baskets. They are low-maintenance plants that require no deadheading.",
                        "dateLastCrawled": "2024-11-02T07:42:00.0000000Z",
