                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.9",
                        "name": "How to Grow and Care for Mexican Petunia - The Spruce",
                        "url": "https://www.thespruce.com/mexican-petunias-growing-guide-5198750",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.DAVJA0zV18ee9XEuM7EHHgHaE8&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2024-08-19T00:00:00.0000000",
                        "datePublishedDisplayText": "Aug 19, 2024",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.thespruce.com/mexican-petunias-growing-guide-5198750",
                        "snippet": "Mexican Petunia Care. Here are the main care requirements for growing low-maintenance Mexican petunias. Plant in full sun for best blooms but partial shade may be fine for this flower. Use rich, well-draining soil to plant Mexican petunia. Keep the soil moist, but this is not a plant that needs monitoring for moisture.",
                        "dateLastCrawled": "2024-11-04T21:34:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.DAVJA0zV18ee9XEuM7EHHgHaE8&w=80&h=80&c=1&pid=5.1",
                            "width": 80,
                            "height": 80,
                            "sourceWidth": 474,
