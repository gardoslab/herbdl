                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.4",
                        "name": "How to Grow and Care for New Guinea Impatiens - Gardener's Path",
                        "url": "https://gardenerspath.com/plants/flowers/grow-new-guinea-impatiens/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.34eBc-ACZ05KxSl9QzWmXgHaD4&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2023-05-26T00:00:00.0000000",
                        "datePublishedDisplayText": "May 26, 2023",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://gardenerspath.com/plants/flowers/grow-new-guinea-impatiens",
                        "snippet": "For in-ground growing, loosen up the soil a foot down. Dig up the soil and add equal parts well-rotted compost, soil conditioner, and/or well-rotted manure. Mix it all together and fill the planting area back in. Then, dig holes the size of the containers that your plants are currently in, spaced 18 inches apart.",
                        "dateLastCrawled": "2024-11-02T16:23:00.0000000Z",
                        "primaryImageOfPage": {
