                        "siteName": "Dave's Garden"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.15",
                        "name": "Solomon\u2019s Seal, Polygonatum spp. - Wisconsin Horticulture",
                        "url": "https://hort.extension.wisc.edu/articles/solomons-seal-polygonatum-spp/",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://hort.extension.wisc.edu/articles/solomons-seal-polygonatum-spp",
                        "snippet": "P. biflorum, Small or Smooth Solomon\u2019s-seal, is native to eastern North America, from New England to Florida and west to Nebraska and Texas. As the common name suggests, the light green 4 inch long leaves are completely hairless. The plant grows 1-6 feet tall, with \u00bd \u2013 \u00be inch long white- or yellow-green flowers in late spring.",
                        "dateLastCrawled": "2024-11-03T21:48:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Variegated+Solomon%27s+Seal+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4735798580281839&mkt=en-US&setlang=en-US&w=VfUVvk9o7bRpl_ornaySLHmeA6wWWlyr",
                        "language": "en",
