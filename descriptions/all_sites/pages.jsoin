                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.9",
                        "name": "Hostas - Sky Nursery",
                        "url": "https://skynursery.com/wp-content/uploads/2019/11/hostas.pdf",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://skynursery.com/wp-content/uploads/2019/11/hostas.pdf",
                        "snippet": "Sky Nursery \u2022 18528 Aurora Avenue North, Shoreline, WA 98133 skynursery.com (206)-546-4851 \u2022 Rev. 8/23/19 Hostas, occasionally called \u201cplantain lilies\u201d or \u201cfunkia\u201d, are among the best-loved shade plants. Hostas are grown primarily for their striking heart-shaped foliage in shades of blue, green,",
                        "dateLastCrawled": "2024-10-31T14:25:00.0000000Z",
