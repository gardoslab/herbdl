                        "siteName": "Florida Wildflower Foundation"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.19",
                        "name": "Variegated Solomon\u2019s Seal #1 gallon pot - English Gardens",
                        "url": "https://www.englishgardens.com/variegated-solomons-seal-1-gallon-pot/",
                        "isFamilyFriendly": true,
