            "webPages": {
                "webSearchUrl": "https://www.bing.com/search?q=Coral+Bells+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping",
                "totalEstimatedMatches": 10200,
                "value": [
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.0",
                        "name": "31 Different Coral Bell (Heuchera) Varieties - Epic Gardening",
                        "url": "https://www.epicgardening.com/heuchera-varieties/",
                        "datePublished": "2023-09-28T00:00:00.0000000",
                        "datePublishedDisplayText": "Sep 28, 2023",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.epicgardening.com/heuchera-varieties",
                        "snippet": "This variety produces beautiful matte, green-veined leaves and delicate reddish-pink, bell-shaped flowers. Zone: 4-9. Flower Color: Pink. Foliage Color: Frosted green. Flower Time: Summer. Height: 10\u2033. Width: 1.5\u2032. \u2018Berry Timeless\u2019 is the perfect name for this variety of coral bells because it is classic.",
                        "deepLinks": [
                            {
                                "name": "How to Plant, Grow, and Care For Coral Bells (Heuchera) - Epic Gardening",
                                "url": "https://www.epicgardening.com/heuchera/",
                                "snippet": "Dig a hole the same depth as the root ball. Then place the plant, adding compost or seedling fertilizer. Planting a coral bell into your garden is fairly straightforward. Dig a hole as deep as the plant or bare root and twice as wide. Take your coral bells out of its pot. Make sure to \u2018scruff\u2019 the root ball."
                            }
