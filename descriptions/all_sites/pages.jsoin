                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.5",
                        "name": "How to grow Solomon's seal - BBC Gardeners World Magazine",
                        "url": "https://www.gardenersworld.com/how-to/grow-plants/how-to-grow-solomons-seal/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.fy1qCuQq6zJ3tC5ttHYSdQHaE8&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2021-08-16T00:00:00.0000000",
                        "datePublishedDisplayText": "Aug 16, 2021",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.gardenersworld.com/how-to/grow-plants/how-to-grow-solomons-seal",
                        "snippet": "The word 'polygonatum' is derived from the ancient Greek for 'many knees', inspired by the jointed rhizomes from which the plants grow.The common name Solomon's seal has many suggested origins \u2013 one theory is that it is inspired by the mark where the stem emerges from the rhizome, which looks like two interlocked triangles, the symbol of the biblical figure Solomon.",
                        "dateLastCrawled": "2024-11-01T18:03:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.fy1qCuQq6zJ3tC5ttHYSdQHaE8&w=80&h=80&c=1&pid=5.1",
                            "width": 80,
