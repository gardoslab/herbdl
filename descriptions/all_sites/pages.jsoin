                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.lOIs0amWB9XsB4gROK-5tgHaD4&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2023-10-09T00:00:00.0000000",
