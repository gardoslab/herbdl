                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.18",
                        "name": "Learn About Black Eyed Susan Care - Gardening Know How",
                        "url": "https://www.gardeningknowhow.com/ornamental/flowers/black-eyed-susan/black-eyed-susan-flower.htm",
                        "datePublished": "2021-04-26T00:00:00.0000000",
                        "datePublishedDisplayText": "Apr 26, 2021",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.gardeningknowhow.com/ornamental/flowers/black-eyed-susan/black-eyed-susan...",
                        "snippet": "Black eyed Susan plants are drought resistant, self-seeding and grow in a variety of soils. Growing black eyed Susans prefer a neutral soil pH and a full sun to light shade location. Black eyed Susan care will often include deadheading the spent blooms of the flower. Deadheading encourages more blooms and a sturdier, more compact plant.",
                        "dateLastCrawled": "2024-11-02T03:44:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Black-eyed+Susan+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4579994346062007&mkt=en-US&setlang=en-US&w=8BiK88jgckUivZd9AR-ZI3RgUK9lviuY",
