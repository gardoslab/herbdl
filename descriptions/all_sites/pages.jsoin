                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.15",
                        "name": "Blue Skies\u00ae Lilac, Syringa vulgaris 'Monore', Monrovia Plant",
                        "url": "https://www.monrovia.com/blue-skies-lilac.html",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.monrovia.com/blue-skies-lilac.html",
                        "snippet": "One of the best lilacs for warm winter areas. Produces spectacular clusters of light lavender-blue flowers without winter chilling! A midseason bloomer that typically flowers in mid-May. Bright green foliage maintains its attractive appearance all summer. Plant near a window or pathway where the fragrant blooms can be enjoyed. Deciduous.",
                        "dateLastCrawled": "2024-11-03T02:51:00.0000000Z",
