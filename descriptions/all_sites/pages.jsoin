                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.3",
                        "name": "Thickspike Gayfeather Plant Guide - Natural Resources Conservation Service",
                        "url": "https://www.nrcs.usda.gov/plantmaterials/kspmcpg8092.pdf",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.nrcs.usda.gov/plantmaterials/kspmcpg8092.pdf",
                        "snippet": "Seeds and Plant Production. Thickspike gayfeather can be propagated by seed or division of its corm. Art (1991) divided the corm vertically into pieces which each contained at least one bud. Plant the divided corm vertically with 30 to 60 cm spacing between individuals and the bud 5 cm below the soils surface.",
                        "dateLastCrawled": "2024-11-01T21:29:00.0000000Z",
