                        "noCache": false,
                        "siteName": "Leafy Place"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.3",
                        "name": "How to Grow and Care for Wax Begonia Indoors - The Spruce",
                        "url": "https://www.thespruce.com/grow-semperflorens-begonias-indoors-1902498",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.urc18t_JRhOdVu9KBg_03AHaE8&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2024-06-27T00:00:00.0000000",
                        "datePublishedDisplayText": "Jun 27, 2024",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.thespruce.com/grow-semperflorens-begonias-indoors-1902498",
                        "snippet": "Watering. Indoor wax begonias should be watered when the soil dries through the first 1/2 inch. Established plants require less moisture and can go a long time between waterings. When watering, make sure it's thorough, and then let the pot drain completely. Do not let begonias sit in water, which encourages root rot.",
                        "dateLastCrawled": "2024-11-05T05:22:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.urc18t_JRhOdVu9KBg_03AHaE8&w=80&h=80&c=1&pid=5.1",
