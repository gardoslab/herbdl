                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.14",
                        "name": "1035 \u2013 Petunia \u2013 PlantTalk Colorado",
                        "url": "https://planttalk.colostate.edu/topics/annuals-perennials/1035-petunia/",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://planttalk.colostate.edu/topics/annuals-perennials/1035-petunia",
                        "snippet": "1035 \u2013 Petunia. Images 1-3: Petunias (Petunia x hybrida spp.) come in many colors. From large, sweeping landscape beds to a few pots on a balcony, petunias reliably provide a long blooming season. These durable annuals, available in almost every color imaginable, can be used in a variety of ways to enhance any garden or terrace.",
                        "dateLastCrawled": "2024-10-29T20:19:00.0000000Z",
