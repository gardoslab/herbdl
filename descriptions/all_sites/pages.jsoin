                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.5",
                        "name": "New Guinea Impatiens: A Profile of an Annual Flower - HowStuffWorks",
                        "url": "https://home.howstuffworks.com/new-guinea-impatiens.htm",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.qM9tNNjVo9jtnpSKiauzZwAAAA&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2007-04-03T00:00:00.0000000",
                        "datePublishedDisplayText": "Apr 3, 2007",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://home.howstuffworks.com/new-guinea-impatiens.htm",
                        "snippet": "Only two varieties of New Guinea impatiens are available from seed so far. Sow 10 to 12 weeks before planting outside. Germinate at 75 to 80 degrees Fahrenheit. Do not cover, since seeds need light to germinate, but mist to keep moist. Cuttings root quickly and easily in 2 to 3 weeks.",
                        "dateLastCrawled": "2024-11-03T06:42:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.qM9tNNjVo9jtnpSKiauzZwAAAA&w=80&h=80&c=1&pid=5.1",
                            "width": 80,
                            "height": 80,
                            "sourceWidth": 400,
