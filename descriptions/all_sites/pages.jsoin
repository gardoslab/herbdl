                        "datePublished": "2024-05-07T00:00:00.0000000",
                        "datePublishedDisplayText": "May 7, 2024",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.thespruce.com/grow-coleus-plants-indoors-1902746",
                        "snippet": "Coleus plants prefer an average temperature above 60\u00b0 F in the summer. In winter, they can tolerate a slightly lower temperature, though they should always be kept about 50\u00b0F. High humidity is also preferred by the coleus, so try keeping your plant in a typically-humid room of the home, like the kitchen or bathroom.",
                        "dateLastCrawled": "2024-11-04T22:29:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Coleus+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4523528405123310&mkt=en-US&setlang=en-US&w=6KvXeI5R2OMJECx1hlsl5gb1OBJyvUN1",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "The Spruce"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.14",
                        "name": "Coleus Plants - Growing, Care & Varieties - Garden Design",
                        "url": "https://www.gardendesign.com/plants/coleus.html",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.gardendesign.com/plants/coleus.html",
                        "snippet": "Coleus plants have a wide range of color variation, from bright chartreuse to hot pink to near-black, and any number of combinations. Coleus leaves range from one to six-inches long, and also come in many different shapes and sizes. A member of the mint family, coleus have unique square stems that this group of plants is known for.",
                        "dateLastCrawled": "2024-11-03T03:29:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Coleus+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4669840764502285&mkt=en-US&setlang=en-US&w=0VoppvcuXeNLmSfXqrkHwWSM8MOm26gU",
