                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.10",
                        "name": "Common Purslane Management Guidelines--UC IPM - ucanr.edu",
                        "url": "https://ipm.ucanr.edu/PMG/PESTNOTES/pn7461.html?pringpage",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://ipm.ucanr.edu/PMG/PESTNOTES/pn7461.html?pringpage",
                        "snippet": "Common purslane, Portulaca oleracea, is a member of the Portulacaceae family with more than 120 different species found in that family. It is a weedy summer annual species that is abundant throughout the world, invading vegetable gardens, bare areas, low-maintenance lawns, ornamental plantings, and agricultural areas.",
