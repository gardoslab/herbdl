                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.4",
                        "name": "Wax Begonia (Begonia Semperflorens): All You Need To Know - Gardenia",
                        "url": "https://www.gardenia.net/genus/begonia-semperflorens-cultorum-wax-begonia",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.SzHzIerMrlVRxy7Y03UM_AHaE7&w=80&h=80&c=1&pid=5.1",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.gardenia.net/genus/begonia-semperflorens-cultorum-wax-begonia",
                        "snippet": "Avoid exposure to temperatures below 50\u00b0F (10\u00b0C). Fertilization: Feed Wax Begonias every 4-6 weeks during the growing season with a balanced, water-soluble fertilizer. Reduce fertilization in the fall as the plant\u2019s growth slows. Pruning: Trim any leggy or dead growth to maintain a compact, bushy appearance.",
                        "dateLastCrawled": "2024-11-03T22:13:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.SzHzIerMrlVRxy7Y03UM_AHaE7&w=80&h=80&c=1&pid=5.1",
                            "width": 80,
                            "height": 80,
                            "sourceWidth": 474,
                            "sourceHeight": 315,
                            "imageId": "OIP.SzHzIerMrlVRxy7Y03UM_AHaE7"
                        },
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Wax+Begonia+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=5063663499936176&mkt=en-US&setlang=en-US&w=qddqGgheogr-sHzk2l1jBDCjKrY1cEb1",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "Gardenia"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.5",
                        "name": "Overwintering Begonias In Cold Climates | Gardening Know How",
                        "url": "https://www.gardeningknowhow.com/ornamental/flowers/begonia/wintering-begonias-overwintering-a-begonia-in-cold-climates.htm",
                        "datePublished": "2023-10-23T00:00:00.0000000",
                        "datePublishedDisplayText": "Oct 23, 2023",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.gardeningknowhow.com/ornamental/flowers/begonia/wintering-begonias-over...",
                        "snippet": "Foliage begonias will require special care in winter. Experienced growers suggest bringing the plants indoors before the arrival of frost late in the season. Just like wax begonias, slowly acclimate your begonias to indoor lighting. Foliage begonias should be kept near a bright window and safely away from cold drafts or heating vents.",
                        "dateLastCrawled": "2024-11-04T19:10:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Wax+Begonia+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4748065005437360&mkt=en-US&setlang=en-US&w=YB_9K3PFIk5vK80f-DTB1K0YHTUZ_a3j",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "Gardening Know How"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.6",
                        "name": "Types of Wax Begonia: In-Depth Guide on Varieties & Uses",
                        "url": "https://foliagefriend.com/types-of-wax-begonia/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.DMy6wJcXh0ogA1sHOhSB3QAAAA&w=80&h=80&c=1&pid=5.1",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://foliagefriend.com/types-of-wax-begonia",
                        "snippet": "To begin, select a healthy wax begonia with a few nodes on its stems. With a clean pair of snips, cut a 3-4 inch sprig from the plant in the spring. Make sure the cutting has a few nodes on it. Remove the bottom leaves about two inches from the bottom, leaving only the top leaves.",
                        "dateLastCrawled": "2024-10-29T07:23:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.DMy6wJcXh0ogA1sHOhSB3QAAAA&w=80&h=80&c=1&pid=5.1",
