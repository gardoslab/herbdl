                        "siteName": "Foliage Friend"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.7",
                        "name": "20 Types of Begonias: Flowers, Leaves (Pictures and Care Guide ...",
                        "url": "https://leafyplace.com/begonia-types/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.MA7Gt4amkPFyZhk90Yoh-AAAAA&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2021-12-09T00:00:00.0000000",
                        "datePublishedDisplayText": "Dec 9, 2021",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://leafyplace.com/begonia-types",
