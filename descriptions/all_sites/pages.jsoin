                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.19",
                        "name": "Black-Eyed Susan \u2013 Gardening Solutions",
                        "url": "https://gardeningsolutions.ifas.ufl.edu/plants/ornamentals/black-eyed-susan/",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://gardeningsolutions.ifas.ufl.edu/plants/ornamentals/black-eyed-susan",
                        "snippet": "Black-eyed Susan seeds can be planted directly in the garden or you can buy small plants. Choose a sunny, well-drained location in the spring. The flowers will develop ten to fourteen weeks after the seed is planted, and should persist throughout the summer while other plants wilt. Deadhead, or remove, faded blossoms to prompt more profuse ...",
                        "dateLastCrawled": "2024-11-03T21:26:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Black-eyed+Susan+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4776106847699573&mkt=en-US&setlang=en-US&w=oIK_uEZBtr577GR4k0z6KaN0_ZHBsZh4",
