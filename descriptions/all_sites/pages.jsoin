                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.19",
                        "name": "Hosta Species Update The Hosta Library ORG20070316 \u00a9W",
                        "url": "http://hostalibrary.org/species/pdf/sieboldii2.pdf",
                        "isFamilyFriendly": true,
                        "displayUrl": "hostalibrary.org/species/pdf/sieboldii2.pdf",
                        "snippet": "Comparative Plant Morphology: Morphometric data for H. sieboldii \u2018Albomarginata\u2019 are provided here and is similar in all respects to that of the all-green, endemic form H. sieboldii var. sieboldii (formerly H. sieboldii var. sieboldii f. spathulata Schmid 1991), except that it is a plastome mutant phenotype with white margins and has therefore been reduced to cultivar rank.",
