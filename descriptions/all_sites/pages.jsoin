                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.12",
                        "name": "Container Grown Bleeding Heart Plants - Gardening Know How",
                        "url": "https://www.gardeningknowhow.com/ornamental/flowers/bleeding-heart/bleeding-heart-container-care.htm",
                        "datePublished": "2022-09-14T00:00:00.0000000",
                        "datePublishedDisplayText": "Sep 14, 2022",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.gardeningknowhow.com/ornamental/flowers/bleeding-heart/bleeding-heart...",
                        "snippet": "Fertilize bleeding heart monthly using a diluted water-soluble fertilizer or apply a controlled release fertilizer according to the schedule indicated on the container. Read the label carefully and avoid overfeeding. As a general rule, too little fertilizer is better than too much. Don\u2019t bother deadheading container-grown bleeding heart plants.",
                        "dateLastCrawled": "2024-11-01T23:05:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Bleeding-heart+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4839118314668640&mkt=en-US&setlang=en-US&w=2VW9o7JMR0GYk91zH8ySOLHUbwEPFIaL",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "Gardening Know How"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.13",
                        "name": "Growing A Bleeding Heart Plant Inside - Gardening Know How",
