                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Coleus+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4662788425646559&mkt=en-US&setlang=en-US&w=q4n0zt4OullIZGmvoj-yftT99qWBPl-j",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "Planet Natural Garden Supply"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.6",
                        "name": "Coleus Plant Care & Complete Growing Guide - Get Busy Gardening",
                        "url": "https://getbusygardening.com/coleus-care/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.mBhi3VWtvKQsvpnKPHnb3AHaD4&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2024-01-17T00:00:00.0000000",
                        "datePublishedDisplayText": "Jan 17, 2024",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://getbusygardening.com/coleus-care",
                        "snippet": "Water. Coleus plants do not tolerate very wet or very dry conditions. Too little water will cause slowed growth, wilting, and browning, while too much can lead to rot or fungal diseases. Keep the soil moderately damp, but not soggy or wet. To maintain the perfect balance, water when the top 1-2\u201d is dry.",
                        "dateLastCrawled": "2024-11-01T02:19:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.mBhi3VWtvKQsvpnKPHnb3AHaD4&w=80&h=80&c=1&pid=5.1",
                            "width": 80,
                            "height": 80,
                            "sourceWidth": 474,
                            "sourceHeight": 248,
                            "imageId": "OIP.mBhi3VWtvKQsvpnKPHnb3AHaD4"
                        },
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Coleus+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4558480850879069&mkt=en-US&setlang=en-US&w=K6lkkKSDhVkY9Xwan0AWLmN3KYlvQq4p",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "Get Busy Gardening"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.7",
                        "name": "How to grow coleus - BBC Gardeners World Magazine",
                        "url": "https://www.gardenersworld.com/how-to/grow-plants/how-to-grow-solenostemon-coleus/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.MQJz4RhvAhcPEuDlOsGSlQHaE8&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2019-01-07T00:00:00.0000000",
                        "datePublishedDisplayText": "Jan 7, 2019",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.gardenersworld.com/how-to/grow-plants/how-to-grow-solenostemon",
                        "snippet": "Prepare the soil by forking in some multipurpose compost. Dig a hole that is slightly larger than the original pot, add the plant and fill around it with soil. Water in well. If planting in a pot, dig a hole that is the same size and depth as the original pot, and plant at the same level. Water in well.",
                        "dateLastCrawled": "2024-11-04T23:39:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.MQJz4RhvAhcPEuDlOsGSlQHaE8&w=80&h=80&c=1&pid=5.1",
                            "width": 80,
                            "height": 80,
