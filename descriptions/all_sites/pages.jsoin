                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.15",
                        "name": "What\u2019s eating my viburnums and how can I stop it?",
                        "url": "https://www.canr.msu.edu/news/keep_your_eyes_open_for_the_viburnum_leaf_beetles",
                        "datePublished": "2020-06-19T00:00:00.0000000",
                        "datePublishedDisplayText": "Jun 19, 2020",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.canr.msu.edu/news/keep_your_eyes_open_for_the_viburnum_leaf_beetles",
                        "snippet": "V. setigerum (tea viburnum) V. sieboldii (Siebold viburnum) *Based on observations at the Van Dusen Botanical Garden, Vancouver, B.C. by Carolyn Jones. Prune out twigs with egg-laying sites. Removing the egg-laden twigs between early October and mid-April can be very successful in reducing the VLB population in your landscape.",
                        "dateLastCrawled": "2024-11-03T04:04:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Siebold+viburnum+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4793445630083365&mkt=en-US&setlang=en-US&w=GzJkiJAHW16DzsIaWtgrakBB_5B6y45a",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "College of Agriculture & Natural Resources"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.16",
                        "name": "Be Alert for Viburnum Beetles - Preen",
                        "url": "https://www.preen.com/learn/lawn-garden-tips/pests-problems/bugs/be-alert-for-viburnum-beetles/",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.preen.com/learn/lawn-garden-tips/pests-problems/bugs/be-alert-for-viburnum...",
                        "snippet": "Destroy any damaged leaves that drop. A few weeks after hatching, the larvae drop to the ground and burrow into the soil to pupate. In about six weeks, the adult beetles emerge, feed on the leaves and lay eggs to start the cycle all over again. The 1/4- to 3/8-inch long, golden-brown beetles look shiny in the sun.",
                        "dateLastCrawled": "2024-06-13T15:42:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Siebold+viburnum+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4940844610684921&mkt=en-US&setlang=en-US&w=yk9KDtsWX23G1leGqXFYo-XhV5zjYPgX",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "Preen"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.17",
                        "name": "Doublefile Viburnum, Viburnum plicatum tomentosum 'Mariesii' - Monrovia",
                        "url": "https://www.monrovia.com/doublefile-viburnum.html",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.monrovia.com/doublefile-viburnum.html",
                        "snippet": "Doublefile Viburnum. The broadly rounded form on this medium-sized deciduous shrub supports tiered horizontal branches that display the magnificent, large, white, lacecap flower clusters, creating a stunning show in spring. The pleated, green foliage may develop fall color in some regions. The red fruit in fall is very ornamental.",
                        "dateLastCrawled": "2024-11-04T04:34:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Siebold+viburnum+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4644835464839515&mkt=en-US&setlang=en-US&w=uF02mzKhwltAOklgnJtZQerkZ0xHYYtD",
                        "language": "en",
