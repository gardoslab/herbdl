                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.16",
                        "name": "Black-Eyed Susan (Rudbeckia Hirta): How to Grow and Care",
                        "url": "https://florgeous.com/black-eyed-susan/",
                        "datePublished": "2024-01-14T00:00:00.0000000",
                        "datePublishedDisplayText": "Jan 14, 2024",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://florgeous.com/black-eyed-susan",
                        "snippet": "Photo by Kaarina Dillabough \u2013 Flickr. Black-eyed Susan is the common name for the entire genus of Rudbeckia (Rudbeckia spp.).Although it often refers explicitly to the Rudbeckia hirta species.. Botanist Carolus Linnaeus gave the genus name Rudbeckia as a nod to the renowned Swedish father and son duo, both named Olof Rudbeck.",
                        "dateLastCrawled": "2024-11-04T14:02:00.0000000Z",
