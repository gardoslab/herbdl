                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.9",
                        "name": "May Birth Flower: Lily of the Valley (Convallaria majalis)",
                        "url": "https://extension.psu.edu/programs/master-gardener/counties/luzerne/news/may-birth-flower-lily-of-the-valley",
                        "datePublished": "2021-05-05T00:00:00.0000000",
                        "datePublishedDisplayText": "May 5, 2021",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://extension.psu.edu/.../counties/luzerne/news/may-birth-flower-lily-of-the-valley",
                        "snippet": "The flower is also known as the May lily, May bells, or French \"Muguet des bois.\" The scientific name is Convallaria majalis. The genus name means \"valley\" and the species name means \"belonging to Maia\" since May is its month of flowering. The fragrant white flowers have been associated with motherhood, chastity, and sweetness.",
                        "dateLastCrawled": "2024-11-03T13:03:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Lily-of-the-Valley+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4757578358522149&mkt=en-US&setlang=en-US&w=fI6U2kSPlvZzf0YkLkRHxGmj5O4qE7LU",
