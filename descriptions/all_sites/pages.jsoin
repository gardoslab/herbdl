                        "noCache": false,
                        "siteName": "Epic Gardening"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.5",
                        "name": "Coleus Guide: How to Grow and Care for Coleus Plants - Planet Natural",
                        "url": "https://www.planetnatural.com/coleus/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.HHghi0G8aP7cKkZHWT0FCAAAAA&w=80&h=80&c=1&pid=5.1",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.planetnatural.com/coleus",
                        "snippet": "Step 4: Planting the Coleus. Before planting, gently remove the coleus from its current container, taking care not to damage the root ball. Place the plant in the new pot, ensuring it\u2019s centred and upright. Fill in around the stem root with the prepared soil, careful not to cover the stem or leaves.",
                        "dateLastCrawled": "2024-11-02T16:14:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.HHghi0G8aP7cKkZHWT0FCAAAAA&w=80&h=80&c=1&pid=5.1",
