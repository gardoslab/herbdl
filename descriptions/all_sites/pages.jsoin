                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.17",
                        "name": "Rudbeckia fulgida (Black-Eyed Susan) - Gardenia",
                        "url": "https://www.gardenia.net/genus/rudbeckia-fulgida-black-eyed-susan",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.gardenia.net/genus/rudbeckia-fulgida-black-eyed-susan",
                        "snippet": "Rudbeckia fulgida, commonly known as Orange Coneflower or Black-eyed Susan, is a native perennial plant of the Eastern United States. It belongs to the Asteraceae family and is renowned for its showy, long-lasting golden-yellow flowers. Habit and Size: The plant forms clumps of stiff, leafy stems, each ending in a daisy-like flower head. It ...",
                        "dateLastCrawled": "2024-11-02T18:42:00.0000000Z",
