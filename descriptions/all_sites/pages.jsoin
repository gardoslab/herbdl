                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.12",
                        "name": "How to Start Petunias from Seed Indoors | Yard and Garden",
                        "url": "https://yardandgarden.extension.iastate.edu/how-to/how-start-petunias-seed-indoors",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://yardandgarden.extension.iastate.edu/how-to/how-start-petunias-seed-indoors",
                        "snippet": "Petunia seeds should germinate in 7 to 10 days. Remove the plastic food wrap or dome as soon as germination occurs. Then place the seedlings under supplemental lights or in a sunny window. Lights should be no more than 4 to 6 inches above the plants and should be left on for 12 to 16 hours. Temperatures should be 60 to 65\u00b0F.",
                        "dateLastCrawled": "2024-11-03T05:24:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Petunia+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4799415636000783&mkt=en-US&setlang=en-US&w=drVbP4xIxBqGhYfz1PaEE8Erm6-elg9p",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.13",
                        "name": "Managing Pests in Gardens: Floriculture: Petunia\u2014UC IPM - ucanr.edu",
                        "url": "https://ipm.ucanr.edu/PMG/GARDEN/FLOWERS/petunia.html",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://ipm.ucanr.edu/PMG/GARDEN/FLOWERS/petunia.html",
                        "snippet": "Petunias are low-growing perennial plants generally treated as annuals. Leaves are thick and somewhat sticky. Flowers may be ruffled or funnel-shaped and are of various colors including white, yellow, red, blue, and purple. They bloom from spring into winter. Petunias are often grown in beds, containers, window boxes, or as ground covers.",
                        "dateLastCrawled": "2024-10-30T00:23:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Petunia+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4802576727998491&mkt=en-US&setlang=en-US&w=WEaPIET-a-iH9Y2j3Lr1MlofhPxRKRpk",
