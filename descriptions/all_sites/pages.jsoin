                        "name": "Purslane Identification and Uses: A Plant Profile",
                        "url": "https://thesurvivalgardener.com/purslane-identification-uses-plant-profile/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.ejTsGg6x8mB70AJu7ngMrQHaD2&w=80&h=80&c=1&pid=5.1",
