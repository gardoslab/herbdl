                        "webSearchUrl": "https://www.bing.com/entityexplore?q=Cotinus&filters=sid:%220bc17d2e-28a6-dc27-d192-0797792d21d0%22&elv=AXXfrEiqqD9r3GuelwApulpKCfKXvP1aQ5OLC4!k1PPJf7!XPRBkgsQeV0u3oDkHdlqv84!kjmNXkNr2dR0akzf8yJvDPx3O8I0vf8M!gqkX",
                        "name": "Cotinus",
                        "image": {
