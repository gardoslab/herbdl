                        "webSearchUrl": "https://www.bing.com/entityexplore?q=Cuphea+ignea&filters=sid:%2239f19568-a480-6401-804e-e16b87397d5e%22&elv=AXXfrEiqqD9r3GuelwApulpKCfKXvP1aQ5OLC4!k1PPJf7!XPRBkgsQeV0u3oDkHdlqv84!kjmNXkNr2dR0akzf8yJvDPx3O8I0vf8M!gqkX",
                        "name": "Cuphea ignea",
                        "image": {
                            "name": "Cuphea ignea",
                            "thumbnailUrl": "http://www.bing.com/th?id=OSK.829093bf0427683640d5fa7221e03786&w=110&h=110&c=7",
                            "provider": [
                                {
                                    "_type": "Organization",
                                    "url": "https://en.wikipedia.org/wiki/Cuphea_ignea"
                                }
                            ],
                            "hostPageUrl": "https://upload.wikimedia.org/wikipedia/commons/d/d8/Cuphea_ignea1.jpg",
                            "width": 110,
                            "height": 110,
                            "sourceWidth": 640,
                            "sourceHeight": 480
                        },
                        "description": "Cuphea ignea, the cigar plant, cigar flower, firecracker plant, or Mexican cigar, is a species of flowering plant in the genus Cuphea of the family Lythraceae. It is a tropical, densely branched evergreen subshrub. This species, native to Mexico and the West Indies, produces small, tubular, bright red to orange flowers. Each flower is tipped with a thin white rim and two small purple-black petals. The flowers, which are attractive to hummingbirds and butterflies, resemble lit cigars, hence the name ignea, which is Latin for \"fiery\". The genus name Cuphea comes from the Greek word kyphos which means curved or humped; this is thought to refer to the shape of the seeds. The leaves are small, elliptical and of a bright green colour. It grows to about 60 cm.",
                        "entityPresentationInfo": {
                            "entityScenario": "DominantEntity",
                            "entityTypeHints": [
                                "Generic"
                            ],
                            "entityTypeDisplayHint": "Species of plant"
                        },
                        "bingId": "39f19568-a480-6401-804e-e16b87397d5e"
                    }
