                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.14",
                        "name": "21 Types of Viburnum: Shrubs, Trees and Hedges (With Pictures)",
                        "url": "https://mississippigreens.com/viburnum-shrubs/",
                        "datePublished": "2023-01-14T00:00:00.0000000",
                        "datePublishedDisplayText": "Jan 14, 2023",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://mississippigreens.com/viburnum-shrubs",
                        "snippet": "Height: 15-20 feet. USDA zones: 3 through 9. Black-haw viburnum is a large shrub or a small tree that can grow to be 15-20 feet tall with a relatively large spread. The leaves of the Blackhaw Viburnum are ovate or elliptical in shape and are dark green in color. They measure around 2-4 inches long and 1-2 inches wide.",
                        "dateLastCrawled": "2024-11-04T10:11:00.0000000Z",
