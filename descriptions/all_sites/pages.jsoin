                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.18",
                        "name": "Viburnum setigerum/NJ - Bugwoodwiki",
                        "url": "https://wiki.bugwood.org/Viburnum_setigerum/NJ",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://wiki.bugwood.org/Viburnum_setigerum/NJ",
                        "snippet": "V. setigerum. Subspecies: V. setigerum. Scientific Name. Viburnum setigerum Hance. Common Names. tea viburnum. Common Name: tea viburnum Family Name: Adoxaceae - Adoxa family Native Range: China NJ Status: Emerging Stage 1 - Rare (may be locally common). It is highly threatening to native communities.",
                        "dateLastCrawled": "2024-10-31T13:02:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Siebold+viburnum+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4773426784764117&mkt=en-US&setlang=en-US&w=mLkjAqS9Yeh6tCVRQcxscMA-MbfCd8D8",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.19",
                        "name": "Pyrrhalta viburni | Insect & Mite Guide | Center for Agriculture, Food ...",
                        "url": "https://ag.umass.edu/landscape/publications-resources/insect-mite-guide/pyrrhalta-viburni",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://ag.umass.edu/landscape/publications-resources/insect-mite-guide/pyrrhalta-viburni",
                        "snippet": "More information is likely to become available in the future. Entomopathogenic nematodes were effective at managing viburnum leaf beetles in lab bioassays. Heterorhabditis bacteriophora and Steinernema carpocapsae were very effective at killing pupae in the lab, reducing adult emergence by 76\u2013100% (Weston and Desurmont, 2008).",
                        "dateLastCrawled": "2024-10-29T23:04:00.0000000Z",
