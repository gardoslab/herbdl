                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.11",
                        "name": "Petunia x hybrida - North Carolina Extension Gardener Plant Toolbox",
                        "url": "https://plants.ces.ncsu.edu/plants/petunia-x-hybrida/",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://plants.ces.ncsu.edu/plants/petunia-x-hybrida",
                        "snippet": "Description. Garden petunia is a tender perennial in the nightshade family (Solanaceae). Its hardiness zones range from 10a to 11b, which results in it being an annual in North Carolina gardens. Petunia\u2019s genus name is derived from the Brazilian name for tobacco. Seeds can be sown in January to March under glass as they require a germination ...",
                        "dateLastCrawled": "2024-11-03T00:30:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Petunia+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=5049687671308595&mkt=en-US&setlang=en-US&w=Su4tYYO6d_n4VUsIqKHs5sKzwgHY07pv",
                        "language": "en",
