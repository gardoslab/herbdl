                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.3",
                        "name": "Sorghastrum nutans (Indian Grass) - Minnesota Wildflowers",
                        "url": "https://www.minnesotawildflowers.info/grass-sedge-rush/indian-grass",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.uGak40r5piZ8n0EbTQDIQQHaLH&w=80&h=80&c=1&pid=5.1",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.minnesotawildflowers.info/grass-sedge-rush/indian-grass",
                        "snippet": "The ligule (membrane where the leaf joins the sheath) is white and 2 to 6 mm long. Usually at the top of the sheath where it meets the ligule is a thick, pointed appendage (auricle) that is as long as or longer than the ligule. Nodes are covered in short, silky hairs giving them a whitish bloom. The culm (stem) is erect, hollow and hairless.",
                        "dateLastCrawled": "2024-11-02T23:33:00.0000000Z",
                        "primaryImageOfPage": {
