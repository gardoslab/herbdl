                        "webSearchUrl": "https://www.bing.com/entityexplore?q=Salvia+yangii&filters=sid:%22f592641e-a520-200e-dd93-c0daa9f35c2d%22&elv=AXXfrEiqqD9r3GuelwApulpKCfKXvP1aQ5OLC4!k1PPJf7!XPRBkgsQeV0u3oDkHdlqv84!kjmNXkNr2dR0akzf8yJvDPx3O8I0vf8M!gqkX",
                        "name": "Salvia yangii",
                        "image": {
                            "name": "Salvia yangii",
                            "thumbnailUrl": "http://www.bing.com/th?id=OSK.5a2580de228ddbcc507155779117d8ba&w=110&h=110&c=7",
                            "provider": [
                                {
                                    "_type": "Organization",
                                    "url": "https://en.wikipedia.org/wiki/Salvia_yangii"
                                }
                            ],
                            "hostPageUrl": "https://upload.wikimedia.org/wikipedia/commons/5/5d/Russian_sage_by_RO_IV.jpg",
                            "width": 110,
                            "height": 110,
                            "sourceWidth": 2418,
                            "sourceHeight": 2200
                        },
                        "description": "Salvia yangii, previously known as Perovskia atriplicifolia, and commonly called Russian sage, is a flowering herbaceous perennial plant and subshrub. Although not previously a member of Salvia, the genus widely known as sage, since 2017 it has been included within them. It has an upright habit, typically reaching 0.5\u20131.2 metres tall, with square stems and gray-green leaves that yield a distinctive odor when crushed. It is best known for its flowers. Its flowering season extends from mid-summer to late October, with blue to violet blossoms arranged into showy, branched panicles.",
