                        "noCache": false,
                        "siteName": "BBC Gardeners World Magazine"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.8",
                        "name": "How to Plant, Grow, and Care For Coleus Plants - Epic Gardening",
                        "url": "https://www.epicgardening.com/coleus/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.u4zRvkXjdz3kufs3zjHWxgHaEc&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2023-10-02T00:00:00.0000000",
                        "datePublishedDisplayText": "Oct 2, 2023",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.epicgardening.com/coleus",
                        "snippet": "Coleus can definitely benefit from an all purpose 20-20-20 fertilizer every two weeks as a part of your fertilizing routine. If you are fertilizing annuals, give some to your coleus as well. Fertilizing will help them grow fast and larger. I love this since I live in an area where they only grow for 3-4 months.",
                        "dateLastCrawled": "2024-11-01T09:13:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.u4zRvkXjdz3kufs3zjHWxgHaEc&w=80&h=80&c=1&pid=5.1",
                            "width": 80,
                            "height": 80,
                            "sourceWidth": 474,
                            "sourceHeight": 284,
                            "imageId": "OIP.u4zRvkXjdz3kufs3zjHWxgHaEc"
                        },
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Coleus+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4877442303132243&mkt=en-US&setlang=en-US&w=XlGuKDuZJUiqAWqM18QPE6JeGmhzTjJX",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "Epic Gardening"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.9",
                        "name": "How to Grow and Care for Coleus - MyDomaine",
                        "url": "https://www.mydomaine.com/coleus-plant-6740012",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.hh3O9jbVEkK6-n8_jmipXgHaE8&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2024-08-28T00:00:00.0000000",
                        "datePublishedDisplayText": "Aug 28, 2024",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.mydomaine.com/coleus-plant-6740012",
                        "snippet": "Use your finger or a pencil to make a hole a few inches deep in the soil. Plant the cutting in the soil and pat gently on the soil surface to anchor it in place. Keep the soil evenly moist but not soggy. When new leaves grow on your new coleus plant, it's ready to be cared for as usual. Sutthiwat Srikhrueadam/Getty Images.",
                        "dateLastCrawled": "2024-10-31T18:00:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.hh3O9jbVEkK6-n8_jmipXgHaE8&w=80&h=80&c=1&pid=5.1",
                            "width": 80,
                            "height": 80,
                            "sourceWidth": 474,
                            "sourceHeight": 316,
                            "imageId": "OIP.hh3O9jbVEkK6-n8_jmipXgHaE8"
                        },
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Coleus+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4979413416214951&mkt=en-US&setlang=en-US&w=oqnaBY11wlzYYGl9Eva7HUy9k3Uj1xrv",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "MyDomaine"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.10",
                        "name": "Coleus Care: How to Grow Colorful Coleus Plant (Extensive Guide)",
                        "url": "https://leafyplace.com/coleus/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.DDud4DByO09rfzLf1qaUQwHaD4&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2021-03-04T00:00:00.0000000",
                        "datePublishedDisplayText": "Mar 4, 2021",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://leafyplace.com/coleus",
                        "snippet": "Propagate your coleus plant from stem cuttings. Cut a stem just below the leaf node, so you have a stem 3\u201d to 4\u201d (7.5 \u2013 10 cm) long. There should be at least three leaves on the stem. You can root a stem cutting in water. Put your propagation stems in a jar of water and leave until roots about 1\u201d (2.5 cm) long appear.",
                        "dateLastCrawled": "2024-11-02T11:30:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.DDud4DByO09rfzLf1qaUQwHaD4&w=80&h=80&c=1&pid=5.1",
