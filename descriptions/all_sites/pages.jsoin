                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.19",
                        "name": "Spicebush, A Warm Fall Woodland Spice - Eat The Planet",
                        "url": "https://eattheplanet.org/spicebush-a-warm-fall-woodland-spice/",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://eattheplanet.org/spicebush-a-warm-fall-woodland-spice",
                        "snippet": "Spicebush (Lindera benzoin) is a shrub native to north eastern United States. It is a common woodland shrub that can be identified easily by the fragrance of its crushed leaves. The leaf shape is difficult to distinguish, especially for beginners. This plant produces red berries in summer which is a prized item for wildlife.",
                        "dateLastCrawled": "2024-11-01T04:18:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Spice+bush+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4560087165240074&mkt=en-US&setlang=en-US&w=uUfVTMxsKLEZsH-vAxUQC-ZS4v11Njxl",
