                            "thumbnailUrl": "http://www.bing.com/th?id=OSK.954d39e03109f0455290d85ea22905e0&w=110&h=75&c=7",
                            "provider": [
                                {
                                    "_type": "Organization",
                                    "url": "https://en.wikipedia.org/wiki/Cotinus"
                                }
                            ],
                            "hostPageUrl": "https://upload.wikimedia.org/wikipedia/commons/5/5d/Cotinus_coggygria33.jpg",
                            "width": 110,
                            "height": 75,
                            "sourceWidth": 3128,
                            "sourceHeight": 2076
                        },
                        "description": "Cotinus, the smoketree or smoke bush, is a genus of seven species of flowering plants in the family Anacardiaceae, closely related to the sumacs. They are large shrubs or small trees, native to the warm temperate Northern Hemisphere. The leaves are deciduous, alternate, simple oval shape, 3\u201313 cm long. The flowers are clustered in a large open terminal panicles 15\u201330 cm long with a fluffy grayish-buff appearance resembling a cloud of smoke over the plant, from which the name derives. The fruit is a small drupe with a single seed. Often classified in Rhus in the past, they are distinguished by the leaves being simple and the 'smoke-like' fluffy flower heads.",
                        "entityPresentationInfo": {
                            "entityScenario": "DominantEntity",
                            "entityTypeHints": [
                                "Generic"
                            ],
                            "entityTypeDisplayHint": "Genus of plants"
                        },
