                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.8",
                        "name": "Hosta (Hosta sieboldiana 'Elegans') in the Hostas Database - Garden.org",
                        "url": "https://garden.org/plants/view/77038/Hosta-Hosta-sieboldiana-Elegans/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.DB1vpCHWSBMjh6YSKKuEnAHaHH&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2016-12-31T00:00:00.0000000",
                        "datePublishedDisplayText": "Dec 31, 2016",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://garden.org/plants/view/77038/Hosta-Hosta-sieboldiana-Elegans",
                        "snippet": "Hosta sieboldiana 'Elegans' is hardy from zone 4 south through zone 9. So, in the southern three of these zones, it is hardy in a large freeze proof container. In this configuration it looks striking placed on either side of entry or patio doors. Just remember to water in winter every 12-14 days and always just before very, very hard freezes.",
                        "dateLastCrawled": "2024-11-01T18:39:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.DB1vpCHWSBMjh6YSKKuEnAHaHH&w=80&h=80&c=1&pid=5.1",
