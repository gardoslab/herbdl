                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.1",
                        "name": "How to Grow Karl Foerster Feather Reed Grass in Your Yard - The Spruce",
                        "url": "https://www.thespruce.com/karl-foerster-feather-reed-grass-care-guide-7570203",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.ngqbFuUHW0WeKmWUIBQP1gHaE8&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2023-09-05T00:00:00.0000000",
                        "datePublishedDisplayText": "Sep 5, 2023",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.thespruce.com/karl-foerster-feather-reed-grass-care-guide-7570203",
                        "snippet": "Karl Foerster feather reed grass is a type of ornamental grass that has a stiff, upright growth habit. In the north, its foliage remains green into late fall, at which point it turns a golden-tan color. In the south, it is evergreen. But an even bigger selling point than its attractive foliage is its flower heads.",
