                        },
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=New+Guniea+Impatiens+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4622643367641830&mkt=en-US&setlang=en-US&w=DwCwNGsV-io2Iug0DOfvJQ4P2_dVX4ji",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "HowStuffWorks"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.6",
                        "name": "Growing Vibrant New Guinea Impatiens Within the Optimal Temperature Range",
                        "url": "https://stonepostgardens.com/new-guinea-impatiens-temperature-range/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.bx6V1NzBsFcypgLrIdLr1wHaE8&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2024-06-02T00:00:00.0000000",
                        "datePublishedDisplayText": "Jun 2, 2024",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://stonepostgardens.com/new-guinea-impatiens-temperature-range",
                        "snippet": "Minimum temperature: 55\u00b0F (13\u00b0C) Optimal daytime range: 70-85\u00b0F (21-29\u00b0C) Optimal nighttime range: 55-65\u00b0F (13-18\u00b0C) Maximum tolerable temperature: 90\u00b0F (32\u00b0C) Aim to keep your new guinea impatiens within these ideal parameters for optimal growth and maximum flower production through the season.",
                        "dateLastCrawled": "2024-10-31T23:28:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.bx6V1NzBsFcypgLrIdLr1wHaE8&w=80&h=80&c=1&pid=5.1",
                            "width": 80,
                            "height": 80,
                            "sourceWidth": 474,
                            "sourceHeight": 316,
                            "imageId": "OIP.bx6V1NzBsFcypgLrIdLr1wHaE8"
                        },
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=New+Guniea+Impatiens+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4650728158527931&mkt=en-US&setlang=en-US&w=j7ZPqJ-lr2FC6FLjJJ5HPxqjNZH2cgmV",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.7",
                        "name": "New Guinea Impatiens Care: Watering, Soil, Light, Pruning ... - Garvillo",
                        "url": "https://garvillo.com/new-guinea-impatiens-care/",
                        "datePublished": "2023-11-22T00:00:00.0000000",
                        "datePublishedDisplayText": "Nov 22, 2023",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://garvillo.com/new-guinea-impatiens-care",
                        "snippet": "Consistency is key: New Guinea Impatiens prefer consistently moist soil, so aim to water them regularly. Avoid letting the soil dry out completely between watering sessions, as this can cause stress to the plants. Deep watering: When you do water your New Guinea Impatiens, make sure to water deeply.",
                        "dateLastCrawled": "2024-11-03T16:28:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=New+Guniea+Impatiens+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4552622518894882&mkt=en-US&setlang=en-US&w=2KL4cMwOomEWS0s5A8d03phCVZ-E9XQY",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "Garvillo"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.8",
                        "name": "The Ultimate Guide to Growing and Caring for New Guinea Impatiens",
                        "url": "https://thegrassyroot.com/how-to-grow-and-care-for-new-guinea-impatiens/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.zsENVqzpSvehb6_06Sc2UQHaE8&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2024-02-22T00:00:00.0000000",
                        "datePublishedDisplayText": "Feb 22, 2024",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://thegrassyroot.com/how-to-grow-and-care-for-new-guinea-impatiens",
                        "snippet": "Soil: Prepare soil that is rich in organic matter and maintains a slightly acidic to neutral pH (6.0 to 7.0). A good potting mix works wonders for container New Guinea Impatiens. Adding compost or peat moss to the soil can improve its texture and fertility, setting the stage for a lush garden or display.",
                        "dateLastCrawled": "2024-10-31T15:53:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.zsENVqzpSvehb6_06Sc2UQHaE8&w=80&h=80&c=1&pid=5.1",
                            "width": 80,
                            "height": 80,
