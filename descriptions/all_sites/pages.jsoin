                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.17",
                        "name": "1058 \u2013 Salvia - PlantTalk Colorado",
                        "url": "https://planttalk.colostate.edu/topics/annuals-perennials/1058-salvia/",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://planttalk.colostate.edu/topics/annuals-perennials/1058-salvia",
                        "snippet": "What is a good perennial salvia? Salvia nemerosa \u2018May Night\u2019 is a perennial salvia that earned a Perennial Plant of the Year award for its long-blooming, indigo-blue flowers. Another worthy perennial sage is Clary sage with pink to cream or blue flowers, but be aware it readily self-sows. Both are hardy to USDA zone 5.",
                        "dateLastCrawled": "2024-10-31T12:05:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Salvia+May+Night+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4889893414502560&mkt=en-US&setlang=en-US&w=DQLFJrNTxOOvqqyPn0dZEawtzmAkYVHc",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "PlantTalk Colorado"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.18",
                        "name": "2 Gal. Salvia May Night Plant 19633 - The Home Depot",
                        "url": "https://www.homedepot.com/p/2-Gal-Salvia-May-Night-Plant-19633/316075077",
                        "datePublished": "2024-05-01T00:00:00.0000000",
                        "datePublishedDisplayText": "May 1, 2024",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.homedepot.com/p/2-Gal-Salvia-May-Night-Plant-19633/316075077",
                        "snippet": "Caradonna Salvia is one the most beautiful salvia that grows up to 24 in. tall and 18 in. W. This perennial thrives in full sun. Flowers attract butterflies and hummingbirds. This perennial has a long blooming season and it is easy to grow! Flowers are great for cutting. You may plant this salvia as beds, borders or mass plantings.",
                        "dateLastCrawled": "2024-10-28T03:00:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Salvia+May+Night+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4614448572204223&mkt=en-US&setlang=en-US&w=swrpgPUFXH8yaNyksruA96bdHT9RKC9F",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "The Home Depot"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.19",
                        "name": "Meadow Sage, Garden Sage - Mountain States Wholesale Nursery",
                        "url": "https://mswn.com/wp-content/uploads/info-sheets/Salvia-nemorosa-May-Night.pdf",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://mswn.com/wp-content/uploads/info-sheets/Salvia-nemorosa-May-Night.pdf",
                        "snippet": "season. \u2018May Night\u2019 is prized as a cut flower, both fresh and dried. The foliage is quite resistant to browsing by deer and rabbits. Add in drought resistance, cold and heat tolerance, and adaptability to varied soils types (from sand to clay), and it is easy to understand why this plant was cho-sen as the 1997 Perennial Plant of the Year.",
                        "dateLastCrawled": "2024-10-27T03:37:00.0000000Z",
