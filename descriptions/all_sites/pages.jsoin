                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.18",
                        "name": "Hosta Library",
                        "url": "https://www.hostalibrary.org/l/lancifolia.html",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.hostalibrary.org/l/lancifolia.html",
                        "snippet": "'Lancifolia' was the first hosta introduced to Western botany. One was acquired by Kaempfer in 1692. Von Siebold sent the first live 'Lancifolia' plants to Holland in 1829. It's origin is unknown, and it is thought to be sieboldii in nature. An excellent groundcover and edger, it is cultivated around the world and is easy to propagate by division.",
                        "dateLastCrawled": "2024-10-28T21:19:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Siebold+Hosta+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4705536235471594&mkt=en-US&setlang=en-US&w=ED7IsFZp6hhb1Pc621nkMp5PFfoCRGaL",
                        "language": "en",
