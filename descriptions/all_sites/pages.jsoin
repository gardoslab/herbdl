                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.1",
                        "name": "Monarda didyma (Beebalm, Bee Balm, Bee-balm, Bergamont, Bergamot ...",
                        "url": "https://plants.ces.ncsu.edu/plants/monarda-didyma/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.luV4I42eSTrH7FHRTcvFsAHaEt&w=80&h=80&c=1&pid=5.1",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://plants.ces.ncsu.edu/plants/monarda-didyma",
                        "snippet": "Blossoms attract bees, hummingbirds, and butterflies, and the leaves have a minty aroma when crushed. Bee balm provides color and contrast for the perennial border, cottage garden, specimen planting, native and pollinator garden, meadow, naturalized planting, and along ponds or streams. It is used in herbal medicine, and its flowers are edible.",
                        "dateLastCrawled": "2024-11-04T18:10:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.luV4I42eSTrH7FHRTcvFsAHaEt&w=80&h=80&c=1&pid=5.1",
