                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.8",
                        "name": "Petunia | Annual, Flowering, Fragrant | Britannica",
                        "url": "https://www.britannica.com/plant/petunia",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.5gbG2MuCcnwfR-S9YMdYpgAAAA&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2024-10-18T00:00:00.0000000",
                        "datePublishedDisplayText": "Oct 18, 2024",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.britannica.com/plant/petunia",
                        "snippet": "petunia, genus of about 35 species of flowering plants in the nightshade family (Solanaceae), native to South America. The common garden petunia (Petunia \u00d7 atkinsiana) is an ornamental plant whose showy trumpet-shaped flowers make it popular for summer flower beds and window boxes. Petunia species are mostly annual herbs.",
                        "dateLastCrawled": "2024-11-04T07:57:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.5gbG2MuCcnwfR-S9YMdYpgAAAA&w=80&h=80&c=1&pid=5.1",
