                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.1",
                        "name": "How to Grow and Care for Wax Begonias | Gardener\u2019s Path",
                        "url": "https://gardenerspath.com/plants/flowers/grow-wax-begonias/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.VpnqosExNUiAapTQIk25uQHaD4&w=80&h=80&c=1&pid=5.1",
                        "about": [
                            {
                                "_type": "CreativeWork",
                                "aggregateRating": {
                                    "ratingValue": 0,
                                    "reviewCount": 1
                                }
                            }
                        ],
                        "datePublished": "2023-05-06T00:00:00.0000000",
                        "datePublishedDisplayText": "May 6, 2023",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://gardenerspath.com/plants/flowers/grow-wax-begonias",
                        "snippet": "In a tray of individual cell packs, fill each flat with a 50:50 mix of peat moss and perlite. Press a seed or two into the surface of the media in each cell, leaving the seeds uncovered. Gently moisten the soil, then cover the tray with clear plastic wrap.",
                        "dateLastCrawled": "2024-11-05T02:22:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.VpnqosExNUiAapTQIk25uQHaD4&w=80&h=80&c=1&pid=5.1",
                            "width": 80,
                            "height": 80,
                            "sourceWidth": 474,
                            "sourceHeight": 248,
                            "imageId": "OIP.VpnqosExNUiAapTQIk25uQHaD4"
                        },
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Wax+Begonia+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4915577324306580&mkt=en-US&setlang=en-US&w=gsaB8GTTjMC7WKO0CbbotQOQRJmIenLE",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": false,
                        "siteName": "Gardener's Path"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.2",
                        "name": "Wax Begonia: Flower, Leaves \u2013 Plant Care Guide (Pictures) - Leafy Place",
                        "url": "https://leafyplace.com/wax-begonia/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.l8BnnQXdmDTqkZzExXNeIAHaD1&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2021-06-17T00:00:00.0000000",
                        "datePublishedDisplayText": "Jun 17, 2021",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://leafyplace.com/wax-begonia",
                        "snippet": "How to plant wax begonia: Plant wax begonias about 6\u201d to 8\u201d (15 \u2013 20 cm) apart. This ensures that the tender annuals have enough room to spread and get adequate air circulation. To grow wax begonias from the tuberous roots, start them indoors and plant them hollow side up about 1\u201d (2.5 cm) apart.",
                        "dateLastCrawled": "2024-11-01T06:08:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.l8BnnQXdmDTqkZzExXNeIAHaD1&w=80&h=80&c=1&pid=5.1",
                            "width": 80,
                            "height": 80,
                            "sourceWidth": 474,
                            "sourceHeight": 245,
                            "imageId": "OIP.l8BnnQXdmDTqkZzExXNeIAHaD1"
                        },
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Wax+Begonia+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4592892132458602&mkt=en-US&setlang=en-US&w=6Fi8jxr1rgwomxK0B64osaz6b5n2qqzX",
                        "language": "en",
