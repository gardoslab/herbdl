                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.16",
                        "name": "Variegated Solomon's Seal (Polygonatum x hybridum 'Striatum') - Garden.org",
                        "url": "https://garden.org/plants/view/175506/Variegated-Solomons-Seal-Polygonatum-x-hybridum-Striatum/",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://garden.org/plants/view/175506/Variegated-Solomons-Seal-Polygonatum-x-hybridum...",
                        "snippet": "Variegated Solomon's Seal (Polygonatum x hybridum 'Striatum') General Plant Information (Edit) Plant Habit: Herb/Forb. Life cycle: Perennial. Sun Requirements: Partial or Dappled Shade. Partial Shade to Full Shade.",
                        "dateLastCrawled": "2024-10-29T20:05:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Variegated+Solomon%27s+Seal+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4989781472837744&mkt=en-US&setlang=en-US&w=ubUOmt7ma-vdFyVNu5izsfGt9xkrbkr9",
