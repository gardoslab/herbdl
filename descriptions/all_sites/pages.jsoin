                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.15",
                        "name": "Sugar Maple ( Acer saccharum ) - wildadirondacks.org",
                        "url": "https://wildadirondacks.org/trees-of-the-adirondacks-sugar-maple-acer-saccharum-Marshall.html",
                        "datePublished": "2018-09-12T00:00:00.0000000",
                        "datePublishedDisplayText": "Sep 12, 2018",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://wildadirondacks.org/trees-of-the-adirondacks-sugar-maple-acer-saccharum...",
                        "snippet": "The Sugar Maple (Acer saccharum) is a large, slow-growing, deciduous tree which flourishes in well-drained soil in the Adirondack Mountains. It is a member of the Soapberry Family. The Sugar Maple is one of about twenty species in the genius Acer which occur in North America. This species has a life span of 200-300 years, with some specimens in old-growth stands persisting to nearly 400 years ...",
                        "dateLastCrawled": "2024-11-05T01:09:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Sugar+Maple+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4667878313230828&mkt=en-US&setlang=en-US&w=hXDvZov_J3RKtI11eljp9sxY7rp8O-Xv",
