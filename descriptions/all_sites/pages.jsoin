                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.9",
                        "name": "Hosta, Siebold - Cornell University",
                        "url": "http://www.gardening.cornell.edu/homegardening/scenee15b.html",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.1ntnf3VDLZF5hWgIhpOuQgHaFZ&w=80&h=80&c=1&pid=5.1",
                        "isFamilyFriendly": true,
                        "displayUrl": "www.gardening.cornell.edu/homegardening/scenee15b.html",
                        "snippet": "How to plant: Propagate by division or separation - Divide in spring when the leaves are first coming up. Divide only if necessary, after the plant has matured in 4 to 5 years. Maintenance and care: Hostas are generally easy to take care of as long as they are given partial shade and lots of moisture.",
                        "dateLastCrawled": "2024-10-28T06:15:00.0000000Z",
                        "primaryImageOfPage": {
                            "thumbnailUrl": "https://www.bing.com/th?id=OIP.1ntnf3VDLZF5hWgIhpOuQgHaFZ&w=80&h=80&c=1&pid=5.1",
