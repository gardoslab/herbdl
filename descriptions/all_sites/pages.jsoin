                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.16",
                        "name": "Sugar maple.pmd - University of Idaho",
                        "url": "https://www.uidaho.edu/-/media/UIdaho-Responsive/Files/Extension/topic/forestry/ATC8-Sugar-maple.pdf",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.uidaho.edu/.../Files/Extension/topic/forestry/ATC8-Sugar-maple.pdf",
                        "snippet": "Biology and Silvics Native to the eastern United States, sugar maple is one of our largest and most important hardwoods. Sugar maples do best in cooler, moist climates. In its native range, temperatures range from winter lows of \u2013 40oF and summer highs of 100oF. Annual precipita-tion ranges from 20 to 80 inches with an average of 50 inches in most the native range. Average growing season ...",
                        "dateLastCrawled": "2024-11-04T23:12:00.0000000Z",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": true,
                        "siteName": "University of Idaho"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.17",
                        "name": "Tree Overview: Sugar Maple - Arbor Day Foundation",
                        "url": "https://www.arborday.org/video/tree-overview-sugar-maple",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.arborday.org/video/tree-overview-sugar-maple",
                        "snippet": "Best known for its syrup, the sugar maple supports one of the largest industries in the United States, producing nearly two million gallons of maple syrup every year valued between $29 and $42 million. This tree is so popular that several states have even claimed it as their state tree, including New York, West Virginia, Wisconsin, and Vermont. Aside from its reputation of being a major source ...",
                        "dateLastCrawled": "2024-11-04T18:34:00.0000000Z",
