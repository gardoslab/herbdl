                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.3",
                        "name": "How To Grow New Guinea Impatiens - Gardening Know How",
                        "url": "https://www.gardeningknowhow.com/ornamental/flowers/impatiens/new-guinea-impatiens.htm",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.5at-bCL7gaaNxZWEJAUAnwHaFj&w=80&h=80&c=1&pid=5.1",
                        "datePublished": "2021-04-26T00:00:00.0000000",
                        "datePublishedDisplayText": "Apr 26, 2021",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.gardeningknowhow.com/ornamental/flowers/impatiens/new-guinea-impatiens.htm",
                        "snippet": "Fill the beds with mass plantings for the best look. Each plant will grow into a rounded mound, and if planted 18 inches (46 cm.) apart, they'll grow to fill in the entire space in a matter of weeks. Keep the plants in the front of the bed 12 inches (31 cm.) away from the edging to keep the front branches from growing onto the lawn or sidewalk.",
                        "dateLastCrawled": "2024-10-29T14:27:00.0000000Z",
                        "primaryImageOfPage": {
