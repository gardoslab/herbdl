                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.4",
                        "name": "Verbena aristigera - North Carolina Extension Gardener Plant Toolbox",
                        "url": "https://plants.ces.ncsu.edu/plants/verbena-aristigera/",
                        "thumbnailUrl": "https://www.bing.com/th?id=OIP.w9FjnOe0UtERpLMZDSfSHQHaFj&w=80&h=80&c=1&pid=5.1",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://plants.ces.ncsu.edu/plants/verbena-aristigera",
                        "snippet": "Description. Moss Verbena is a spreading plant with good drought tolerance that has naturalized from Georgia to Florida growing in old fields, waste areas and roadsides. Prefers full sun and well-drained soil. Tolerates sandy and low fertility soil. It can be grown as an annual outside of its growing range.",
