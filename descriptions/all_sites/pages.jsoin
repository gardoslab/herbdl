                        "noCache": false,
                        "siteName": "Healthy Focus"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.19",
                        "name": "Lady's Mantle, Alchemilla mollis | American Meadows",
                        "url": "https://www.americanmeadows.com/product/perennials/ladys-mantle",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.americanmeadows.com/product/perennials/ladys-mantle",
                        "snippet": "Lady's Mantle is a classic beauty long cherished for velvety, scallop-edged foliage and chartreuse blooms. Growing in soft mounds, the light green to olive foliage is ignored by deer and rabbits. Sprays of loosely clustered flowers create an airy halo above the plants in late spring and early summer. Lady's Mantle makes a lush groundcover and easy complement many other perennials.",
                        "dateLastCrawled": "2024-10-29T15:41:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Lady%27s+Mantle+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4703152530129341&mkt=en-US&setlang=en-US&w=cQRvde-Dtd1av2o2p6ZuhJDuJzvWdPR-",
