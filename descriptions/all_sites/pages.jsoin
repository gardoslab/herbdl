                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.18",
                        "name": "8 Amazing Benefits of Lady's Mantle - Healthy Focus",
                        "url": "https://healthyfocus.org/benefits-of-ladys-mantle/",
                        "datePublished": "2018-05-22T00:00:00.0000000",
                        "datePublishedDisplayText": "May 22, 2018",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://healthyfocus.org/benefits-of-ladys-mantle",
                        "snippet": "See also 7 Amazing Benefits of Damiana-2024 Checklist. Lady\u2019s Mantle has also been known to help treat scrapes, cuts, burns, bug bites, and stings and may prove a useful sunscreen. Lady\u2019s mantle helps to speed up the healing process as well as prevent infection. It has antimicrobial properties and has also been used to treat sores and ulcers.",
                        "dateLastCrawled": "2024-11-05T05:36:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Lady%27s+Mantle+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4954283564859635&mkt=en-US&setlang=en-US&w=KS6ISWNLAszM8spL1GWX98AREz8DZfdx",
                        "language": "en",
