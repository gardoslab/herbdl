                        "noCache": false,
                        "siteName": "Wikipedia"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.11",
                        "name": "Plants of Texas Rangelands \u00bb Yellow Indiangrass",
                        "url": "https://rangeplants.tamu.edu/plant/yellow-indiangrass/",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://rangeplants.tamu.edu/plant/yellow-indiangrass",
                        "snippet": "The leaf blades are wide and long with a long ligule that resembles rabbit ears when dry. The panicle is 8 to 12 inches long and bronze to yellow in color. The awns are about 1/2 inch long with a bend in the middle. They are closely twisted before the bend. Yellow Indiangrass is a perennial, warm-season, native - 36 to 96 inches tall.",
                        "dateLastCrawled": "2024-11-03T03:22:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Indian+Grass+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4814104425857315&mkt=en-US&setlang=en-US&w=nS9HcFNZuLKNM7Pe6er02g51y1VrC295",
                        "language": "en",
