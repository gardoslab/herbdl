                        "datePublished": "2017-09-21T00:00:00.0000000",
                        "datePublishedDisplayText": "Sep 21, 2017",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://www.gardenguides.com/115300-vinca-varieties.html",
                        "snippet": "Vinca Major. Vinca major is an evergreen perennial that is hardy to about 20 degrees F. Often used as a groundcover because it roots wherever it touches the ground, this invasive plant produces pinwheel-shaped flowers that may be up to 2 inches across. Vinca major is vine-like with glossy dark green leaves and grows in mounds that can reach 2 feet.",
                        "dateLastCrawled": "2024-11-01T18:16:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Annual+Vinca+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4995515247820963&mkt=en-US&setlang=en-US&w=nGdc5XV6r9Pfspa90OYkRtqel-IezK_A",
                        "language": "en",
