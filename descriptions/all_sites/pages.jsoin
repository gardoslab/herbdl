                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.6",
                        "name": "Solomon\u2019s Seal, Polygonatum spp. - Master Gardener Program",
                        "url": "https://mastergardener.extension.wisc.edu/files/2015/12/Polygonatum.pdf",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://mastergardener.extension.wisc.edu/files/2015/12/Polygonatum.pdf",
                        "snippet": "As the common name suggests, the light green 4 inch long leaves are completely hairless. The plant grows 1-6 feet tall, with 1\u20442 - 3\u20444 inch long white- or yellow-green fl owers in late spring. It is hardy in zones 3-9. P. communatum, Great Solomon\u2019s-seal, is now often considered just a larger form of P. bifl orum, growing 5-6\u2019 tall.",
                        "dateLastCrawled": "2024-11-04T09:41:00.0000000Z",
                        "language": "en",
                        "isNavigational": false,
                        "noCache": true,
                        "siteName": "Master Gardener Program"
                    },
                    {
                        "id": "https://api.bing.microsoft.com/api/v7/#WebPages.7",
                        "name": "Companion Plantings for Variegated Solomon's Seal in the Shade Garden",
                        "url": "https://stonepostgardens.com/variegated-solomons-seal-companion-plants/",
                        "datePublished": "2024-09-13T00:00:00.0000000",
                        "datePublishedDisplayText": "Sep 13, 2024",
                        "isFamilyFriendly": true,
                        "displayUrl": "https://stonepostgardens.com/variegated-solomons-seal-companion-plants",
                        "snippet": "Variegated Solomon\u2019s Seal is not flashy like other variegated plants. This refined elegance makes it an easy addition to an already established planting. Solomon\u2019s Seal also changes to a lovely soft yellow color as the first frosts hit. Deer rarely browse on the thick leaves. Slugs can be an issue as the new growth emerges in the spring.",
                        "dateLastCrawled": "2024-11-02T01:09:00.0000000Z",
                        "cachedPageUrl": "http://cc.bingj.com/cache.aspx?q=Variegated+Solomon%27s+Seal+(biology+OR+information+OR+botany+OR+scientific)+-blog+-shopping&d=4673697646838031&mkt=en-US&setlang=en-US&w=lgObj97jpXZNWjmJUrAH3IAp0FG5IC_Y",
